# Configuración del servidor
PROJECT_NAME="MenuQR API"
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Seguridad
SECRET_KEY=super_secret_jwt_key_please_change_in_production_9f8d7c6b5a4
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos
# Nota: Neon (y la mayoría de Postgres gestionados) requieren SSL — agregar
# ?sslmode=require al final de la connection string en producción.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/menuqr

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Dominios permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://admin.menuqr.com

# Base pública del frontend (URL codificada en el QR)
FRONTEND_BASE_URL=http://localhost:3000

# Base pública de este backend (sirve los QR generados cuando Cloudinary está en modo mock)
BACKEND_BASE_URL=http://localhost:8000
