# Variables para `docker-compose up` — copiar a `.env` en la raíz del repo antes
# de levantar los contenedores (docker compose lee `.env` automáticamente).
# Esto es independiente de backend/.env y frontend/.env, que solo se usan para
# correr cada servicio manualmente (venv/npm run dev) fuera de Docker.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=menuqr

# --- Backend ---
# Obligatorio: sin este valor, `docker compose up` falla al levantar el backend
# (a propósito — evita arrancar en producción con una clave insegura por defecto).
# Generar uno nuevo, por ejemplo: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_real_secret_key

# Los valores mock_cloud/mock_key/mock_secret son un centinela real, no un placeholder
# cualquiera: `cloudinary_service.is_configured` (backend/app/services/cloudinary.py)
# los compara literalmente para decidir si usar Cloudinary real o el fallback local
# (guarda QRs/imágenes en el volumen backend_static). Poner aquí cualquier otro texto
# (ej. "your_api_key") hace que la app CREA que tiene credenciales reales, intente
# subir a Cloudinary de verdad, y falle con 500 "AuthorizationRequired" — pasó en la
# verificación de este mismo docker-compose.yml.
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret

# Dominios que pueden llamar a la API (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000

# --- URLs públicas ---
# Deben apuntar a donde el navegador del usuario final puede alcanzar cada
# servicio (no a los nombres internos de Docker Compose como "backend"/"frontend").
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BASE_URL=http://localhost:3000
